{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "com.camunda.kafka.test",
  "fields": [
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "customerName",
      "type": "string"
    },
    {
      "name": "amount",
      "type": "double"
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "OrderStatus",
        "symbols": ["CREATED", "APPROVED", "REJECTED", "SHIPPED", "DELIVERED"]
      }
    },
    {
      "name": "priority",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "Priority",
          "symbols": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        }
      ],
      "default": null
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderItem",
          "fields": [
            {
              "name": "productId",
              "type": "string"
            },
            {
              "name": "quantity",
              "type": "int"
            },
            {
              "name": "price",
              "type": "double"
            }
          ]
        }
      }
    },
    {
      "name": "shippingAddress",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Address",
          "fields": [
            {
              "name": "street",
              "type": "string"
            },
            {
              "name": "city",
              "type": "string"
            },
            {
              "name": "country",
              "type": "string"
            }
          ]
        }
      ],
      "default": null
    }
  ]
}
